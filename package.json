{
    "name": "@unikue/ts-multi-map",
    "version": "1.1.1",
    "title": "TsMultiMap",
    "description": "Multiple key/value map & range map for typescript",
    "homepage": "https://unikueltd.github.io/ts-multi-map",
    "organization": "Unikue Ltd",
    "private": false,
    "license": "MIT",
    "keywords": [
        "multi-map",
        "multiple-map",
        "many-keys-map",
        "many-values-map",
        "range-map",
        "readonly-multi-map",
        "readonly-multiple-map",
        "readonly-many-keys-map",
        "readonly-many-values-map",
        "readonly-range-map"
    ],
    "files": [
        "dist"
    ],
    "main": "dist/cjs/index.js",
    "module": "dist/esm/index.js",
    "unpkg": "dist/umd/ts-multi-map.min.js",
    "types": "dist/esm/index.d.ts",
    "sideEffects": false,
    "scripts": {
        "build": "del-cli ./dist && father build",
        "build:doctor": "father doctor",
        "build:watch": "father dev",
        "docs:build": "typedoc --out ./docs-dist",
        "docs:publish": "gh-pages -d ./docs-dist",
        "lint": "eslint \"{src,test}/**/*.{js,jsx,ts,tsx}\"",
        "lint:fix": "eslint --fix \"{src,test}/**/*.{js,jsx,ts,tsx}\"",
        "test": "jest",
        "test:coverage": "del-cli ./coverage && jest --coverage --coverageDirectory ./coverage"
    },
    "dependencies": {
        "@babel/runtime": "^7.29.2",
        "object-hash": "^3.0.0"
    },
    "devDependencies": {
        "@eslint/eslintrc": "^3.3.5",
        "@eslint/js": "^10.0.1",
        "@types/jest": "^30.0.0",
        "@types/node": "^25.6.0",
        "@types/object-hash": "^3.0.6",
        "@unikue/babel-plugin-remove-comment": "^1.2.0",
        "@unikue/typedoc-plugin-raw-content": "^1.1.0",
        "@unikue/typedoc-theme-dumi": "^1.1.1",
        "del-cli": "^7.0.0",
        "eslint": "^10.3.0",
        "eslint-plugin-jest": "^29.15.2",
        "father": "^4.6.19",
        "gh-pages": "^6.3.0",
        "globals": "^17.6.0",
        "ts-jest": "^29.4.9",
        "typedoc": "~0.28.19",
        "typescript": "^6.0.3",
        "typescript-eslint": "^8.59.1"
    },
    "peerDependencies": {
        "typescript": ">=4.0.0"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/unikueltd/ts-multi-map.git"
    },
    "bugs": {
        "url": "https://github.com/unikueltd/ts-multi-map/issues"
    },
    "publishConfig": {
        "access": "public",
        "registry": "https://registry.npmjs.org"
    },
    "collective": {
        "url": "https://opencollective.com/unikue-awesome"
    },
    "funding": [
        {
            "type": "opencollective",
